{
  "name": "n8n-nodes-hashicorp-vault-ruvic",
  "version": "1.0.0",
  "description": "Ruvic connector for HashiCorp Vault infrastructure credential lifecycle (KV, dynamic secrets, rotation, leases).",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "hashicorp",
    "vault",
    "ruvic",
    "secrets",
    "approle"
  ],
  "license": "MIT",
  "author": {
    "name": "Ruvic",
    "email": "hello@ruvic.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YersusZ/Hashicorp-vault-ruvic.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && npm run copy:assets",
    "copy:assets": "mkdir -p dist/nodes/HashiCorpVault && cp nodes/HashiCorpVault/*.svg nodes/HashiCorpVault/*.json dist/nodes/HashiCorpVault/",
    "dev": "tsc --watch",
    "test": "jest",
    "test:integration": "VAULT_INTEGRATION=true jest tests/vault.integration.test.ts",
    "lint": "tsc --noEmit"
  },
  "files": [
    "dist",
    "manifest.json",
    "docs"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/HashiCorpVaultApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/HashiCorpVault/HashiCorpVault.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.70.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
